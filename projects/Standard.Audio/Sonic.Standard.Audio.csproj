<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>preview</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>false</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <PackageId>Sonic.Standard.Audio</PackageId>
        <RootNamespace>Std.Audio</RootNamespace>
        <Description>Sonic audio sub-domain: DSP, analysis, filter graph, format facade, extension host.</Description>
        <Authors>Sonic Team</Authors>
        <Company>Sonic</Company>
        <Product>Sonic</Product>
        <PackageTags>sonic;audio;dsp;analysis;filter;codec</PackageTags>
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageOutputPath>..\..\packages</PackageOutputPath>
        <PackageReadmeFile>readme.md</PackageReadmeFile>
    </PropertyGroup>
    <ItemGroup>
        <None Include="readme.md" Pack="true" PackagePath=""/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Sonic.Core\Sonic.Core.csproj"/>
        <ProjectReference Include="..\Sonic.Standard\Sonic.Standard.csproj"/>
        <ProjectReference Include="..\Standard.Data.Binary\Standard.Data.Binary.csproj" />
        <ProjectReference Include="..\Sonic.Standard.Data.Binary\Flac\Nyar.Binary.Flac.csproj"/>
        <ProjectReference Include="..\Sonic.Standard.Data.Binary\Wav\Wav.csproj"/>
    </ItemGroup>
</Project>
