<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>
        <RootNamespace>Std.Template.EBook</RootNamespace>
        <AssemblyName>Sonic.Standard.Template.EBook</AssemblyName>
        <PackageId>Sonic.Standard.Template.EBook</PackageId>
        <Version>0.1.0</Version>
        <Authors>NyarVM</Authors>
        <Description>电子书导出器（PDF/EPUB）</Description>
        <PackageProjectUrl>https://github.com/nyar-vm/DejavuEngine</PackageProjectUrl>
        <RepositoryUrl>https://github.com/nyar-vm/DejavuEngine</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageTags>template;ebook;pdf;epub</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Dejavu\Dejavu.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="PuppeteerSharp" Version="20.0.5"/>
    </ItemGroup>

    <!-- 排除引用未实现类型（EpubEncoder/EpubMetadata 等）的文件 -->
    <ItemGroup>
        <Compile Remove="EpubGenerator.cs"/>
        <Compile Remove="EBookGenerator.cs"/>
        <Compile Remove="PdfGenerator.cs"/>
    </ItemGroup>

</Project>