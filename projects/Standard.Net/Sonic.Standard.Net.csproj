<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>preview</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>true</ImplicitUsings>
        <DisableImplicitFrameworkReferences>false</DisableImplicitFrameworkReferences>
        <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <RootNamespace>Std.Net</RootNamespace>
        <PackageId>Sonic.Standard.Net</PackageId>

        <Description>Sonic 标准网络库：HTTP 服务器、路由、中间件、WebSocket、RPC 客户端、Signal 实时通信</Description>
        <Authors>Sonic Team</Authors>
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.NETCore.App"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Sonic.Standard\Sonic.Standard.csproj"/>
    </ItemGroup>
</Project>