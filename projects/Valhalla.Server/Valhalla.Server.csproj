<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Description>瓦尓哈拉 HTTP 服务端 — 处理发布、检索、管理 REST API 请求</Description>
        <Authors>Nyar Team</Authors>
        <RootNamespace>Valhalla.Server</RootNamespace>
        <AssemblyName>Valhalla.Server</AssemblyName>
        <OutputType>Exe</OutputType>
            <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="NSec.Cryptography" Version="26.*"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Valhalla\Valhalla.csproj"/>
        <ProjectReference Include="..\Valhalla.Config\Valhalla.Config.csproj"/>
    </ItemGroup>


  <ItemGroup>
        <Compile Remove="ValhallaServer.cs"/>
  
        <Compile Remove="Storage\S3Storage.cs"/>
        <Compile Remove="ValhallaApi.cs"/>
    </ItemGroup>
</Project>
