[*]
charset = utf-8
indent_style = space

[*.{json,toml}]
indent_size = 4

[*.md]
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4
max_line_length = 256 # Good for AI Agents

dotnet_naming_style.snake_case.capitalization = all_lower
dotnet_naming_style.snake_case.word_separator = _

dotnet_naming_style.underscored_snake_case.capitalization = all_lower
dotnet_naming_style.underscored_snake_case.word_separator = _
dotnet_naming_style.underscored_snake_case.required_prefix = _

dotnet_naming_symbols.public_fields_and_properties.applicable_kinds = field, property
dotnet_naming_symbols.public_fields_and_properties.applicable_accessibilities = public

dotnet_naming_symbols.private_fields_and_properties.applicable_kinds = field, property
dotnet_naming_symbols.private_fields_and_properties.applicable_accessibilities = private, protected, internal, protected_internal, private_protected

dotnet_naming_symbols.methods.applicable_kinds = method
dotnet_naming_symbols.methods.applicable_accessibilities = *

dotnet_naming_rule.public_should_be_snake_case.symbols = public_fields_and_properties
dotnet_naming_rule.public_should_be_snake_case.style = snake_case
dotnet_naming_rule.public_should_be_snake_case.severity = warning

dotnet_naming_rule.private_should_be_underscored_snake_case.symbols = private_fields_and_properties
dotnet_naming_rule.private_should_be_underscored_snake_case.style = underscored_snake_case
dotnet_naming_rule.private_should_be_underscored_snake_case.severity = warning

dotnet_naming_rule.methods_should_be_snake_case.symbols = methods
dotnet_naming_rule.methods_should_be_snake_case.style = snake_case
dotnet_naming_rule.methods_should_be_snake_case.severity = warning
