<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>
        <Description>VCC — Valkyrie Compiler Collection 编译器命令行工具</Description>
        <Authors>Valkyrie Team</Authors>
        <Version>0.1.0</Version>
        <OutputType>Exe</OutputType>
        <AssemblyName>vcc</AssemblyName>
        <RootNamespace>Valkyrie.CLI</RootNamespace>
        <PublishAot>true</PublishAot>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <!-- NuGet 全局工具打包配置 -->
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>vcc</ToolCommandName>
        <PackageId>Valkyrie.Compiler.CLR</PackageId>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/nyar-vm/NyarVM.cs</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>valkyrie;compiler;vcc;clr</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\projects\Nyar.Language\Nyar.Language.csproj"/>
        <ProjectReference Include="..\..\projects\Nyar\Nyar.csproj"/>
        <ProjectReference Include="..\..\projects\Sonic.Standard\Sonic.Standard.csproj"/>
        <ProjectReference Include="..\..\projects\Sonic.Standard.Command\Sonic.Standard.Command.csproj"/>
    </ItemGroup>
</Project>
